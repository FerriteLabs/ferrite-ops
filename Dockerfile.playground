# syntax=docker/dockerfile:1
#
# Ferrite Web Playground
# Serves the interactive playground at play.ferrite.dev
#
# ferrite-ops does not vendor the Ferrite source (see the primary
# Dockerfile). This build fetches the pinned source tarball for
# FERRITE_VERSION from the public FerriteLabs/ferrite GitHub repository,
# verified against FERRITE_SOURCE_SHA256, using the exact same defaults as
# the primary Dockerfile.
#
# Build:   docker build -t ferritelabs/playground -f Dockerfile.playground .
# Run:     docker run -p 8080:8080 -p 6379:6379 ferritelabs/playground
# Access:  http://localhost:8080

ARG FERRITE_VERSION=0.4.0
FROM rust:1.95-slim-bookworm AS base

# ca-certificates/curl to fetch the pinned source tarball (tar ships with
# the base image already); pkg-config/libssl-dev to build it.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---------- Source stage: fetch the pinned, checksum-verified source ----------
# Same pin and checksum as the primary Dockerfile's `source` stage: any
# override of FERRITE_VERSION/FERRITE_SOURCE_URL must be paired with a
# matching --build-arg FERRITE_SOURCE_SHA256, or the build fails here.
# Split into its own stage (buildable on its own via
# `docker build --target source`) so the network fetch + checksum
# verification can be tested quickly without a full Rust compile.
FROM base AS source
ARG FERRITE_VERSION
ARG FERRITE_SOURCE_URL=https://github.com/FerriteLabs/ferrite/archive/refs/tags/v${FERRITE_VERSION}.tar.gz
ARG FERRITE_SOURCE_SHA256=b4db8cc8eb0d3c2cef4a019a47d550c347df69fb8a4f77550c814fae463005cf

RUN if [ -z "$FERRITE_SOURCE_SHA256" ]; then \
        echo "error: FERRITE_SOURCE_SHA256 build-arg is required to verify the fetched Ferrite source tarball; refusing to build without it." >&2; \
        exit 1; \
    fi \
    && curl -fsSL "$FERRITE_SOURCE_URL" -o /tmp/ferrite-src.tar.gz \
    && echo "${FERRITE_SOURCE_SHA256}  /tmp/ferrite-src.tar.gz" | sha256sum -c - \
    && mkdir -p /app \
    && tar -xzf /tmp/ferrite-src.tar.gz -C /app --strip-components=1 \
    && rm -f /tmp/ferrite-src.tar.gz \
    && test -f /app/Cargo.toml \
    && rm -f /app/.cargo/config.toml

# Preserve the Dockerfile's explicit Rust toolchain instead of allowing the
# fetched contributor toolchain file to replace it. Ferrite v0.3.0 and v0.4.0
# expose the Linux io_uring module when the optional feature is disabled, so
# gate it consistently. Both releases also need mutable Linux eBPF fields.
RUN rm -f rust-toolchain rust-toolchain.toml \
    && if [ "$FERRITE_VERSION" = "0.3.0" ] || [ "$FERRITE_VERSION" = "0.4.0" ]; then \
        sed -i \
          -e 's/#\[cfg(target_os = "linux")\]/#[cfg(all(target_os = "linux", feature = "io-uring"))]/g' \
          -e 's/#\[cfg(not(target_os = "linux"))\]/#[cfg(any(not(target_os = "linux"), not(feature = "io-uring")))]/g' \
          crates/ferrite-core/src/io/mod.rs; \
    fi \
    && if [ "$FERRITE_VERSION" = "0.3.0" ] || [ "$FERRITE_VERSION" = "0.4.0" ]; then \
        sed -i 's/let fields = vec!\[/let mut fields = vec![/g' \
          src/commands/handlers/ebpf.rs; \
    fi

# ---------- Build stage ----------
FROM source AS builder

# Build the RESP server and CLI from the fetched, verified Ferrite source.
RUN cargo build --release --bin ferrite --bin ferrite-cli

# The repository-owned launcher provides the HTTP playground and supervises
# the Ferrite RESP child process. It talks to Ferrite over the same real RESP
# interface exposed to users, so HTTP and RESP clients share one data store.
COPY playground-launcher /app/playground-launcher
RUN FERRITE_VERSION="${FERRITE_VERSION}" CARGO_TARGET_DIR=/app/target cargo build --release \
    --manifest-path /app/playground-launcher/Cargo.toml

# Verify all runtime binaries were built.
RUN ls -lh \
    /app/target/release/ferrite \
    /app/target/release/ferrite-cli \
    /app/target/release/ferrite-playground-launcher

# ---------- Runtime stage ----------
FROM debian:bookworm-slim AS runtime

# Re-declare the global ARG so the OCI version label below receives the
# pinned/overridden value inside this stage.
ARG FERRITE_VERSION

# CA roots and runtime OpenSSL linkage, plus curl for the real HTTP healthcheck.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/ferrite /usr/local/bin/ferrite
COPY --from=builder /app/target/release/ferrite-cli /usr/local/bin/ferrite-cli
COPY --from=builder /app/target/release/ferrite-playground-launcher /usr/local/bin/ferrite-playground-launcher

# Run both services as the same unprivileged user and keep RESP data writable.
RUN groupadd --gid 1000 ferrite \
    && useradd --uid 1000 --gid ferrite --no-create-home --shell /bin/sh ferrite \
    && mkdir -p /var/lib/ferrite/data \
    && chown -R ferrite:ferrite /var/lib/ferrite

ENV RUST_LOG=ferrite=info \
    FERRITE_VERSION=${FERRITE_VERSION}

EXPOSE 8080 6379

# Probe the actual RESP-backed HTTP endpoint served by the launcher.
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD curl --fail --silent --show-error http://127.0.0.1:8080/api/health >/dev/null || exit 1

USER ferrite

ENTRYPOINT ["/usr/local/bin/ferrite-playground-launcher"]

# Build information labels
LABEL org.opencontainers.image.title="Ferrite Playground"
LABEL org.opencontainers.image.description="Interactive RESP-backed web playground for Ferrite"
LABEL org.opencontainers.image.version="${FERRITE_VERSION}"
LABEL org.opencontainers.image.authors="Jose David Baena"
LABEL org.opencontainers.image.source="https://github.com/ferritelabs/ferrite"
LABEL org.opencontainers.image.licenses="Apache-2.0"
